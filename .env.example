# Admin UI (safe to expose)
VITE_API_MODE=mock
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server only — never prefix with VITE_
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Direct Postgres (migrations). Never commit a real password.
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres?sslmode=require
# IPv4 session pooler — use when the direct host is IPv6-only
DATABASE_POOLER_URL=postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?sslmode=require

# Cloudflare R2 (signed uploads/downloads) — Phase 5
# If R2_ACCOUNT_ID / keys / endpoint are empty, the app uses a private Supabase Storage bucket named `media`.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=e3-signage-media
R2_ENDPOINT=
